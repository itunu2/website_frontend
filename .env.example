# ─── PUBLIC (exposed to browser) ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRAPI_BASE_URL=http://127.0.0.1:1337
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=6
NEXT_PUBLIC_STRAPI_REVALIDATE_SECONDS=60

# ─── SERVER-ONLY (never exposed to browser) ───
STRAPI_BLOG_API_TOKEN=               # Strapi Admin → Settings → API Tokens
SUPABASE_URL=                        # https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # Supabase Dashboard → Settings → API → service_role key
NEWSLETTER_ADMIN_TOKEN=              # Any strong random string
NEWSLETTER_WEBHOOK_SECRET=           # Any strong random string (used by /api/webhooks/subscriber-added)
DATABASE_URL=                        # Supabase connection string URI — for newsletter:apply-sql
RESEND_API_KEY=                      # From https://resend.com/api-keys
CONTACT_EMAIL_TO=adegbayiitunuoluwa@gmail.com
