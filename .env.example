# ─── PUBLIC (exposed to browser) ───
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_STRAPI_BASE_URL=https://your-backend.onrender.com
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=6
NEXT_PUBLIC_STRAPI_REVALIDATE_SECONDS=60

# ─── SERVER-ONLY (never exposed to browser) ───
STRAPI_BLOG_API_TOKEN=               # Strapi Admin → Settings → API Tokens → create read-only token
RESEND_API_KEY=                      # https://resend.com/api-keys
CONTACT_EMAIL_TO=                        # Your email address — contact form submissions are sent here
SUPABASE_URL=                        # https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # Supabase Dashboard → Settings → API → service_role key
